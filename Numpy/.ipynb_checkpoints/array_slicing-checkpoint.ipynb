   "source": [
    "import numpy as np\n",
    "# Slicing\n",
    "\n",
    "arr = np.array([1, 2, 3, 4, 5])\n",
    "\n",
    "print(arr[1:4])   # [start, end, step]\n",
    "print(arr[1:])\n",
    "print(arr[:4])\n",
    "print(arr[::2])"
   ]
  },
